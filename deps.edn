{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/io — Layer 3 (I/O) of the kotoba foundational stdlib.
 ;; IReader/IWriter protocols (host-injected) + a pure byte-buffer + copy.
 ;; The streaming abstraction the other libs and actors re-roll, in one place.
 ;; Zero third-party runtime deps; .cljc. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        io.github.kotoba-lang/kotoba-io-reader
        {:git/url "https://github.com/kotoba-lang/kotoba-io-reader.git"
         :git/sha "a1a1351ed58f2db0d26ea98a03c6155c0baa8563"}
        io.github.kotoba-lang/kotoba-io-writer
        {:git/url "https://github.com/kotoba-lang/kotoba-io-writer.git"
         :git/sha "bf3e4c3a5c0aaf801f5833b039438d8fe8268bc9"}
        io.github.kotoba-lang/kotoba-io-buffer-writer
        {:git/url "https://github.com/kotoba-lang/kotoba-io-buffer-writer.git"
         :git/sha "3eed4760fc84bf5ca2b7ca3b9dc467b0e065d8d7"}
        io.github.kotoba-lang/kotoba-io-byte-buffer
        {:git/url "https://github.com/kotoba-lang/kotoba-io-byte-buffer.git"
         :git/sha "239cc81560e0688fc9533684a606010d65750325"}
        io.github.kotoba-lang/kotoba-io-copy
        {:git/url "https://github.com/kotoba-lang/kotoba-io-copy.git"
         :git/sha "3938fa941a42ddf35a3e73cb7ba959cd2e589cb2"}
        io.github.kotoba-lang/kotoba-io-len
        {:git/url "https://github.com/kotoba-lang/kotoba-io-len.git"
         :git/sha "d1578506df867d50b399318504a09f882eed5cf7"}
        io.github.kotoba-lang/kotoba-io-put
        {:git/url "https://github.com/kotoba-lang/kotoba-io-put.git"
         :git/sha "186ceb28a2f8efe45580810079267eaddbb89d2f"}
        io.github.kotoba-lang/kotoba-io-reader-buffer
        {:git/url "https://github.com/kotoba-lang/kotoba-io-reader-buffer.git"
         :git/sha "b48e4b31779eeacc425cd51be941ae00f2272472"}
        io.github.kotoba-lang/kotoba-io-reader-seq
        {:git/url "https://github.com/kotoba-lang/kotoba-io-reader-seq.git"
         :git/sha "2e2ec2b66fb644ac61c565ff6eb6872ab530786b"}
        io.github.kotoba-lang/kotoba-io-to-bytes
        {:git/url "https://github.com/kotoba-lang/kotoba-io-to-bytes.git"
         :git/sha "bc953d18f3aa2cf29c221f9a86e9e680d6e2f920"}

}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
